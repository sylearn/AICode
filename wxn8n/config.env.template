# 微信机器人配置文件

# 文件保存路径（用于保存下载的文件）
SAVE_PATH=

# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)  
LOG_LEVEL=INFO

# 微信参数配置
# LISTEN_INTERVAL：监听间隔时间
LISTEN_INTERVAL=1
# ENABLE_FILE_LOGGER：是否启用文件日志
ENABLE_FILE_LOGGER=False
# DEBUG_MODE：是否启用调试模式
DEBUG_MODE=True

# Webhook URLs(你在n8n中创建的webhook的URL)
# WEBHOOK_TEST_URL：测试环境webhook URL
# WEBHOOK_PROD_URL：生产环境webhook URL
WEBHOOK_TEST_URL=
WEBHOOK_PROD_URL=

# 监听用户名单 (用逗号分隔)
# 监听用户名单：监听用户发送的消息
LISTEN_USERS=
# 监听群组名单：监听群组发送的消息
LISTEN_GROUPS=
# 群组Plus用户名单：群组Plus用户发送的消息
GROUP_PLUS_USERS=

# 请求超时设置 (秒)
# 请求超时设置：请求超时时间
# IMG_DOWNLOAD_TIMEOUT：图片下载超时时间
REQUEST_TIMEOUT=300
IMG_DOWNLOAD_TIMEOUT=30

# 认证头信息（在n8n中创建的webhook的认证头信息）
# AUTH_HEADER_KEY：认证头信息
# AUTH_HEADER_VALUE：认证头信息
AUTH_HEADER_KEY=
AUTH_HEADER_VALUE=

# 错误图片路径（如果生成图片失败，会发送这个图片）
ERROR_IMG_PATH=
